#!/usr/bin/env bash
#
# Pre-commit hook: refuse to commit changes that introduce git merge conflict
# markers (`<<<<<<<`, `=======`, `>>>>>>> `). Catches the case where a merge
# resolution was forgotten and the marker-annotated file got staged.
#
# Why global: conflict markers in a committed file are bad in any repo. Caught
# real fallout in the OpenClaw vault on 2026-06-01 — 24 files committed with
# unresolved markers by git-rest's MarkerResolver; vault scanner silently
# skipped them; dedup degraded.
#
# Detection: for each added/modified staged path, inspect the STAGED BLOB and
# flag it when its content still contains a marker line. Trailing space in the
# pattern prevents false positives on legitimate `<<<<<<<` strings in code.
#
# Why blob-based and not `git diff --cached -G '^<<<<<<< '` (the original):
# git's `-G` matches a pattern appearing in ADDED **or REMOVED** lines, so a
# commit that *deletes* marker lines — i.e. the conflict repair this hook is
# asking for — tripped the guard and was refused. The hook blocked the only
# fix that satisfies it, and the sole escape was `--no-verify`, which drops
# every other check too. Testing the resulting blob asks the question we
# actually care about: "does the thing I am about to commit contain markers?"
# (Fixed 2026-09-07 after it blocked an OpenClaw vault conflict repair.)
#
# Emergency override: `git commit --no-verify` (bypasses ALL client hooks).
#
# Installed globally via `core.hooksPath = ~/.git-hooks` in .gitconfig.osx.

set -euo pipefail

# Skip when committing inside a temp/sandbox repo (test fixtures, throwaway
# workdirs under /tmp or macOS /var/folders). MarkerResolver tests legitimately
# commit files with markers as part of the contract being verified — those
# sandboxes cannot affect any shared state, so the guard would be a false positive.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
case "$repo_root" in
	/tmp/*|/var/folders/*|/private/tmp/*|/private/var/folders/*) exit 0 ;;
esac

# -z keeps paths with spaces/quotes intact (vault task filenames routinely
# contain both); git would otherwise C-quote them and the loop would misread.
flagged=""
while IFS= read -r -d '' path; do
	if git show ":$path" 2>/dev/null | grep -qE '^(<<<<<<< |>>>>>>> )'; then
		flagged="${flagged}${path}"$'\n'
	fi
done < <(git diff --cached --diff-filter=AM --name-only -z)
flagged="${flagged%$'\n'}"

if [ -n "$flagged" ]; then
	echo "" >&2
	echo "✋ Refusing commit: staged changes contain git merge conflict markers" >&2
	echo "" >&2
	echo "   Files:" >&2
	printf '%s\n' "$flagged" | sed 's/^/     /' >&2
	echo "" >&2
	echo "   Resolve the conflict (pick a side, remove the markers) before committing." >&2
	echo "   Emergency override: git commit --no-verify" >&2
	echo "" >&2
	exit 1
fi
# --- Windows-safe filenames (Obsidian vaults only) --------------------------
# Windows cannot check out a path containing : ? * " < > |, one whose component
# ends in a dot or a space, or one with a component whose stem is a reserved
# device name (CON PRN AUX NUL COM1-9 LPT1-9). Such a path commits fine on macOS
# and then blocks `git pull` on the Windows clone — the Personal vault sat 77,656
# commits behind from August to October 2026 because ~145 of them were on
# origin/master.
#
# The stem, not the whole name, is what Windows reserves: MS documents that
# "NUL.txt and NUL.tar.gz are both equivalent to NUL", so the test is on the text
# before the first dot. Matching the whole name instead would let NUL.txt.md
# through. And it is every component, not just the leaf: Windows rejects a
# *directory* named NUL just as it rejects a file, so NUL/notes.md is unsafe too.
#
# Scope: any repo carrying an .obsidian/ directory, i.e. an Obsidian vault.
# Code repos are deliberately exempt — a test fixture may legitimately carry one
# of these characters, and no code repo syncs to Windows.
#
# Renames are safe in both directions and must stay that way: `--name-only` with
# `--diff-filter=AMR` reports only the DESTINATION of a rename, so renaming an
# unsafe name to a safe one commits cleanly — which is the remediation this block
# itself prescribes. Verified 2026-10-03 for a plain rename and for a rename with
# heavy content change (both ALLOW); a rename *to* an unsafe name is still caught.
#
# Wording is load-bearing. git-ai-sync classifies a refusal by substring match on
# git's stderr: `is_marker_refusal()` in git_ai_sync/git_operations.py fires on
# "refusing commit" OR "conflict markers". A message carrying either phrase is
# read as a conflict-marker refusal — git-ai-sync then hunts for marker files,
# finds none, and sys.exit(1)s with "Run 'git-ai-sync resolve <path>'", pointing
# the operator at conflict resolution for a filename problem. This block says
# "Blocked" and never either phrase, so git-ai-sync raises a plain GitError and
# logs "Sync failed: ... Continuing to watch..." — the file stays uncommitted,
# the daemon stays up, and the next tick retries. test-pre-commit.sh pins this.
#
# Residual, accepted: the flagged paths are echoed into this message, so a file
# whose own name contains one of those two phrases (e.g. "Fix conflict markers:
# in X.md") can still re-trigger that misclassification. The commit is blocked
# either way — only the daemon bounce and the wording differ — and moving the
# path list to stdout to dodge it would split the message across two streams and
# print the paths out of order in the normal case.
#
# Emergency override: `git commit --no-verify` (bypasses ALL client hooks).
if [ -d "$repo_root/.obsidian" ]; then
	# Read the staged paths into a file rather than a process substitution: a
	# substitution's exit status never reaches `set -e`, so a failing
	# `git diff` would leave the loop with nothing to read and let the commit
	# through — a guard that fails open exactly when it cannot do its job.
	staged_list="$(mktemp "${TMPDIR:-/tmp}/winfilename.XXXXXX")"
	trap 'rm -f "$staged_list"' EXIT
	if ! git diff --cached --diff-filter=AMR --name-only -z >"$staged_list"; then
		echo "" >&2
		echo "✋ Blocked: could not read the staged paths, so the Windows-safe" >&2
		echo "   filename check could not run. Refusing to guess." >&2
		echo "" >&2
		echo "   Emergency override: git commit --no-verify" >&2
		echo "" >&2
		exit 1
	fi

	unsafe=""
	while IFS= read -r -d '' path; do
		base="${path##*/}"
		reason=""
		# nocasematch so the reserved-device test is case-insensitive without
		# forking a `tr`; bash 3.1+, so it holds on macOS's stock bash 3.2.
		shopt -s nocasematch
		if [[ "$path" =~ [:?*\"\<\>\|] ]]; then
			reason='contains one of  : ? * " < > |'
		elif [[ "$path" =~ [\ .]/ ]]; then
			reason="has a path component ending in a dot or a space"
		elif [[ "$base" =~ [\ .]$ ]]; then
			reason="ends in a dot or a space"
		elif [[ "$path" =~ (^|/)(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.[^/]*)*($|/) ]]; then
			reason="has a path component that is a reserved Windows device name"
		fi
		shopt -u nocasematch
		if [ -n "$reason" ]; then
			unsafe="${unsafe}${path}  —  ${reason}"$'\n'
		fi
	done <"$staged_list"
	# No `rm` here: the EXIT trap owns cleanup, and the nested-path check below
	# reads the same list.
	unsafe="${unsafe%$'\n'}"

	if [ -n "$unsafe" ]; then
		echo "" >&2
		echo "✋ Blocked: staged path is not safe on Windows" >&2
		echo "" >&2
		printf '%s\n' "$unsafe" | sed 's/^/     /' >&2
		echo "" >&2
		echo "   Windows rejects these characters in a path component: : ? * \" < > |" >&2
		echo "   It also rejects a component ending in a dot or a space, and a name" >&2
		echo "   whose stem is a reserved device: CON PRN AUX NUL COM1-9 LPT1-9." >&2
		echo "" >&2
		echo "   Rename the file, then commit again:" >&2
		echo "     notesmd-cli move --vault <vault> \"<old>\" \"<new>\"" >&2
		echo "" >&2
		echo "   Emergency override: git commit --no-verify" >&2
		echo "" >&2
		exit 1
	fi

	# --- Nested path under a content root (Obsidian vaults only) --------------
	# A vault write that builds a filename from a title containing "/" writes a
	# DIRECTORY named after the title's prefix holding a file named after its
	# remainder: the title "Add dev/staging worktrees" lands on disk as a
	# directory "25 Tasks/Add dev" holding "staging worktrees.md". The joined path
	# is what git tracks, so `git ls-files` and every path-based reader see a
	# normal flat task while a flat glob (`25 Tasks/*.md`) never descends and never
	# sees it — the row is half-visible, and one reader reports the set complete
	# while another is silent.
	#
	# The character test above cannot catch this: "/" is a legitimate path
	# separator, so it is deliberately absent from that class. The defect here is
	# the SHAPE, not a character — a content root that should be flat is not.
	#
	# The rule is deliberately narrow. A "parent directory contains a space" rule
	# was measured and rejected: it fires on 155 legitimate paths across the
	# registered vaults ("50 Knowledge Base/Recurring Template Verdicts/...",
	# "55 AI Knowledge Sharing/Draft/...", "30 Analysis/prod/ORB DE40 V25/...").
	# Scoping to the four content roots that hold title-derived filenames gives
	# exactly one hit across all 14 registered vaults — the real defect — and zero
	# false positives. Measured 2026-10-03.
	#
	# Hidden components are exempt: private-agent's tasks/.task-watcher-tests-archive/
	# is a legitimate archive, not a title-derived directory. Non-markdown leaves
	# are exempt too — this defect always produces a .md.
	#
	# Emergency override: `git commit --no-verify` (bypasses ALL client hooks).
	nested=""
	while IFS= read -r -d '' path; do
		case "/$path" in *"/."*) continue ;; esac
		case "$path" in *.md) ;; *) continue ;; esac
		case "$path" in */*/*) ;; *) continue ;; esac
		first="${path%%/*}"
		shopt -s nocasematch
		if [[ "$first" =~ ^([0-9]+\ )?(tasks|goals|topics|runbooks)$ ]]; then
			nested="${nested}${path}"$'\n'
		fi
		shopt -u nocasematch
	done <"$staged_list"
	nested="${nested%$'\n'}"

	if [ -n "$nested" ]; then
		echo "" >&2
		echo "✋ Blocked: a task or goal file sits in a subdirectory, where a flat" >&2
		echo "   glob (25 Tasks/*.md) will never see it." >&2
		echo "" >&2
		printf '%s\n' "$nested" | sed 's/^/     /' >&2
		echo "" >&2
		echo "   A title containing \"/\" builds a directory from its prefix and a file" >&2
		echo "   from its remainder. Git tracks the joined path, so the row looks" >&2
		echo "   normal to path-based readers and is invisible to every flat glob." >&2
		echo "" >&2
		echo "   Flatten it, then commit again:" >&2
		echo "     vault-cli filename sanitize -    # derives the safe stem from stdin" >&2
		echo "     notesmd-cli move --vault <vault> \"<old>\" \"<new>\"" >&2
		echo "" >&2
		echo "   Emergency override: git commit --no-verify" >&2
		echo "" >&2
		exit 1
	fi
fi

exit 0
