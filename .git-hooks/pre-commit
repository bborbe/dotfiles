#!/usr/bin/env bash
#
# Pre-commit hook: refuse to commit changes that introduce git merge conflict
# markers (`<<<<<<<`, `=======`, `>>>>>>> `). Catches the case where a merge
# resolution was forgotten and the marker-annotated file got staged.
#
# Why global: conflict markers in a committed file are bad in any repo. Caught
# real fallout in the OpenClaw vault on 2026-06-01 — 24 files committed with
# unresolved markers by git-rest's MarkerResolver; vault scanner silently
# skipped them; dedup degraded.
#
# Detection: for each added/modified staged path, inspect the STAGED BLOB and
# flag it when its content still contains a marker line. Trailing space in the
# pattern prevents false positives on legitimate `<<<<<<<` strings in code.
#
# Why blob-based and not `git diff --cached -G '^<<<<<<< '` (the original):
# git's `-G` matches a pattern appearing in ADDED **or REMOVED** lines, so a
# commit that *deletes* marker lines — i.e. the conflict repair this hook is
# asking for — tripped the guard and was refused. The hook blocked the only
# fix that satisfies it, and the sole escape was `--no-verify`, which drops
# every other check too. Testing the resulting blob asks the question we
# actually care about: "does the thing I am about to commit contain markers?"
# (Fixed 2026-09-07 after it blocked an OpenClaw vault conflict repair.)
#
# Emergency override: `git commit --no-verify` (bypasses ALL client hooks).
#
# Installed globally via `core.hooksPath = ~/.git-hooks` in .gitconfig.osx.

set -euo pipefail

# Skip when committing inside a temp/sandbox repo (test fixtures, throwaway
# workdirs under /tmp or macOS /var/folders). MarkerResolver tests legitimately
# commit files with markers as part of the contract being verified — those
# sandboxes cannot affect any shared state, so the guard would be a false positive.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
case "$repo_root" in
	/tmp/*|/var/folders/*|/private/tmp/*|/private/var/folders/*) exit 0 ;;
esac

# -z keeps paths with spaces/quotes intact (vault task filenames routinely
# contain both); git would otherwise C-quote them and the loop would misread.
flagged=""
while IFS= read -r -d '' path; do
	if git show ":$path" 2>/dev/null | grep -qE '^(<<<<<<< |>>>>>>> )'; then
		flagged="${flagged}${path}"$'\n'
	fi
done < <(git diff --cached --diff-filter=AM --name-only -z)
flagged="${flagged%$'\n'}"

if [ -n "$flagged" ]; then
	echo "" >&2
	echo "✋ Refusing commit: staged changes contain git merge conflict markers" >&2
	echo "" >&2
	echo "   Files:" >&2
	printf '%s\n' "$flagged" | sed 's/^/     /' >&2
	echo "" >&2
	echo "   Resolve the conflict (pick a side, remove the markers) before committing." >&2
	echo "   Emergency override: git commit --no-verify" >&2
	echo "" >&2
	exit 1
fi

exit 0
